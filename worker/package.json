{
  "name": "laforge-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "db:local": "wrangler d1 execute laforge --local --file=schema.sql",
    "db:remote": "wrangler d1 execute laforge --remote --file=schema.sql",
    "db:paiement": "wrangler d1 execute laforge --remote --file=migrations/001-paiement.sql",
    "db:commandes": "wrangler d1 execute laforge --remote --file=migrations/002-commandes.sql",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "^4.20.0"
  }
}
